{
  "name": "aurora-music",
  "private": true,
  "version": "1.6.0",
  "description": "Aurora Music - 高颜值本地音乐播放器",
  "author": "Aurora Music",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5273",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5273",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "app": "electron .",
    "app:cdp": "electron . --remote-debugging-port=9333",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.aurora.music",
    "productName": "Aurora Music",
    "copyright": "Aurora Music",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-安装包.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurora Music",
      "artifactName": "${productName}-${version}-安装包.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
